# --- required ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME            # your GROUP's key (never commit the real one)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require   # Supabase/Neon Postgres
ADMIN_TOKEN=choose-a-long-random-string        # protects /admin/* and the admin dashboard

# --- optional ---
MODEL_NAME=claude-haiku-5-5
MAX_SPEND_USD=1.7                              # self-imposed kill switch (key limit is $2)
PRICE_IN_PER_MTOK=1.0                          # used only for cost estimates in the admin dashboard
PRICE_OUT_PER_MTOK=5.0
SEED_DEMO=1                                    # create demo_user_1 / demo_user_2 sample data
PORT=7860
